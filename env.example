# Supabase Public Keys (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Supabase service role (ZORUNLU, yalnızca sunucu): doğrulama, istatistik, vergi, cron, hesap silme.
# Gizli tutun, asla commit etmeyin.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sitenin adresi: yönlendirmeler, e-posta bağlantıları, sitemap
NEXT_PUBLIC_SITE_URL=https://influmatch.net


# Cron görevleri (Vercel cron ve Supabase pg_cron isteklerini doğrular; supabase/cron/hourly_jobs.sql)
CRON_SECRET=uzun-rastgele-bir-deger

# Harici servis anahtarları: asıl yönetim admin panelinden (/admin/api-keys) yapılır.
# Buradaki değer, panel boşken bir kez havuza aktarılır.
APIFY_API_TOKEN=

# Admin uyarı e-postaları (https://resend.com)
RESEND_API_KEY=
# Boş bırakılırsa role = admin olan kullanıcıların e-postasına gider (virgülle birden fazla yazılabilir)
ALERT_EMAIL_TO=
# Resend test göndericisi sadece Resend hesabının sahibine gönderir; alan adı doğrulayınca değiştirin
ALERT_EMAIL_FROM=Influmatch <onboarding@resend.dev>
# Resend plan sınırları (ücretsiz plan: günde 100, ayda 3000). Panel ve saatlik uyarı bunlara göre hesaplar.
RESEND_DAILY_LIMIT=100
RESEND_MONTHLY_LIMIT=3000
# Kullanıcılara giden e-postaların göndereni (ör. kurumsal e-posta doğrulama kodu).
# ZORUNLU: Resend'de alan adınızı doğrulayın, aksi halde kodlar markalara ulaşmaz.
EMAIL_FROM=Influmatch <dogrulama@influmatch.net>

# Vergi levhası doğrulama: varsayılan (boş / false) her levha admin onayına düşer.
# true yapılırsa tüm kontrolleri geçen levhalar admin beklemeden otomatik onaylanır.
TAX_AUTO_APPROVE=false

# TikTok etkileşim oranı için örneklenen son video sayısı (varsayılan 1)
TIKTOK_VIDEO_SAMPLE=1

# Instagram/TikTok OAuth (şu an kapalı). true yapılmadan login uçları başlamaz.
SOCIAL_OAUTH_ENABLED=false
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
